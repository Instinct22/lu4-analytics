# Copy to .env and replace placeholder secrets before deploy:
#   cp .env.example .env
#
# Generate secrets: openssl rand -hex 32

JWT_SECRET=change-me-in-production
IMPORT_API_KEY=change-import-key

# Database (must match docker-compose / existing pgdata volume)
POSTGRES_USER=lu4
POSTGRES_PASSWORD=lu4secret
POSTGRES_DB=lu4

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost,http://localhost:5173

# Initial users: login:password pairs, comma-separated
SEED_USERS=admin:admin123,user1:pass123

# Production tuning
UVICORN_WORKERS=1
HTTP_PORT=80

# Local docker-compose.yml: backend hot-reload (true) vs prod workers (false)
DEV_RELOAD=true
